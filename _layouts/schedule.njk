---
layout: 'base.njk'
---

<div>
    <h1 class="title ">{{ title }}</h1>
    <p>{{ description | safe }}</p>
</div>

  {{ content | safe }}

  <div class="schedule">
    {%- for day in collections.schedule -%}

    <h2 id="{{ day.data.title | slugify }}" {{ 'aria-current=page' if (day.data.title | lower) === site.weekday }}>
      {{ day.data.title }}
    </h2>

    {%- if day.data.events -%}       
    <dl>
      {%- for event in day.data.events -%}
        <div>
        <dt>{{ event.timeslot }}</dt>
        {%- for group in event.groups -%}
          <dd>
            <b>{{ group.name }}</b>
            <span> &middot; </span>
            <span>Bane {{ group.court }}</span>
            {%- if group.info -%}
            <p>{{ group.info | markdownInline | safe }}</p>
            {%- endif -%}
          </dd>
        {%- endfor -%} 
      </div>
      {%- endfor -%}
    </dl>
    {%- endif -%}
    {%- if day.data.info -%}
    <p>{{ day.data.info | markdownInline | safe }}</p>
    {%- endif -%}
    {%- endfor -%}
    <div class="spacer-edge"></div>
  </div> 

